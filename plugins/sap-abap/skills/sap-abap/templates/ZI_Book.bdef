managed implementation in class zbp_i_book unique;
strict ( 2 );

define behavior for ZI_Book alias Book
persistent table zbook
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create;
  update;
  delete;

  field ( readonly ) Id, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;
  field ( mandatory ) Title, Price;

  determination setDefaults on modify { create; }
  validation     validatePrice on save { field Price; create; }
  action         applyDiscount parameter ZA_DiscountParams result [1] $self;

  mapping for zbook
  {
    Id            = id;
    Title         = title;
    Author        = author;
    Price         = price;
    CurrencyCode  = currency_code;
    Stock         = stock;
    CreatedBy     = created_by;
    CreatedAt     = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
  }
}
